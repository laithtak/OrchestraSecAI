# Database
DATABASE_URL=postgresql+asyncpg://orchestrasec:orchestrasec@postgres:5432/orchestrasecai
DATABASE_URL_SYNC=postgresql://orchestrasec:orchestrasec@postgres:5432/orchestrasecai

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://web:3000

# Worker
WORKER_CONCURRENCY=2
SCAN_GLOBAL_TIMEOUT_SECONDS=1800

# AI / vLLM
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
MOCK_AI=true
QDRANT_ENABLED=false
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Feature flags
MULTI_TENANT_ENABLED=false

# Rate limits
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_SCANS_PER_DAY=50
RATE_LIMIT_FAIL_OPEN=true
TRUSTED_PROXY_DEPTH=0

# Observability
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
OTEL_ENABLED=true
OTEL_SERVICE_NAME_API=orchestrasecai-api
OTEL_SERVICE_NAME_WORKER=orchestrasecai-worker
OTEL_EXPORTER_OTLP_ENDPOINT=

# Seed (first run)
SEED_ADMIN_EMAIL=admin@orchestrasec.local
SEED_ADMIN_PASSWORD=changeme123

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
