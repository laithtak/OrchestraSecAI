# Application mode (development, test, or production)
# The Docker quick start is a development environment. Production enables strict safety checks.
APP_ENV=development

# Database
# Replace the published development credentials before using production mode.
DATABASE_URL=postgresql+asyncpg://orchestrasec:orchestrasec@postgres:5432/orchestrasecai
DATABASE_URL_SYNC=postgresql://orchestrasec:orchestrasec@postgres:5432/orchestrasecai

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
# Production requires a non-placeholder JWT secret of at least 32 bytes.
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# API
API_HOST=0.0.0.0
API_PORT=8000
# Production requires explicit origins and rejects the wildcard origin.
CORS_ORIGINS=http://localhost:3000,http://web:3000

# Worker / scan lifecycle (see docs/scan-lifecycle.md)
WORKER_CONCURRENCY=2
SCAN_GLOBAL_TIMEOUT_SECONDS=1800
SCAN_MAX_ATTEMPTS=2
SCAN_LEASE_SECONDS=120
SCAN_HEARTBEAT_SECONDS=20
SCAN_REQUEUE_AFTER_SECONDS=120
SCAN_QUEUE_MAX_AGE_SECONDS=3600
# Per-scan network budgets enforced by the egress transport
SCAN_MAX_REQUESTS=2000
SCAN_MAX_RESPONSE_BYTES=1000000
# Active (non-passive) probes: also require a per-scan opt-in by an owner/admin
ACTIVE_PROBES_ALLOWED=false

# Domain ownership verification (DNS TXT challenge)
DOMAIN_VERIFICATION_CHALLENGE_TTL_HOURS=72
DOMAIN_VERIFICATION_MAX_AGE_DAYS=30
DOMAIN_VERIFICATION_CHECK_COOLDOWN_SECONDS=10
DOMAIN_VERIFICATION_DNS_TIMEOUT_SECONDS=5
# Optional comma-separated public resolvers (empty = system resolver)
DOMAIN_VERIFICATION_NAMESERVERS=

# AI / vLLM
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Mock AI is development/test-only and must be false in production.
MOCK_AI=true
QDRANT_ENABLED=false
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Feature flags
MULTI_TENANT_ENABLED=false

# Rate limits
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_SCANS_PER_DAY=50
# Production requires fail-closed rate limiting (false).
RATE_LIMIT_FAIL_OPEN=true
TRUSTED_PROXY_DEPTH=0

# Observability
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
OTEL_ENABLED=true
OTEL_SERVICE_NAME_API=orchestrasecai-api
OTEL_SERVICE_NAME_WORKER=orchestrasecai-worker
OTEL_EXPORTER_OTLP_ENDPOINT=

# Seed (development first run only; production requires SEED_ENABLED=false)
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@orchestrasec.local
SEED_ADMIN_PASSWORD=changeme123

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
